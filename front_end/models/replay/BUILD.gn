import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

devtools_module("replay") {
  sources = [
    "ExecutionHistory.ts",
    "ReplayController.ts",
    "ReplaySession.ts",
  ]
  deps = [
    "../../core/common:bundle",
    "../../core/sdk:bundle",
    "../../generated:protocol",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "replay.ts"
  deps = [ ":replay" ]
  visibility = [
    ":*",
    "../../entrypoints/*",
    "../../panels/*",
  ]
  visibility += devtools_models_visibility
}

ts_library("unittests") {
  testonly = true
  sources = [
    "ExecutionHistory.test.ts",
    "ReplayController.test.ts",
    "ReplaySession.test.ts",
  ]
  deps = [
    ":bundle",
    "../../testing",
  ]
}

ts_library("browser_test_support") {
  testonly = true
  sources = [ "ReplayTestHarness.ts" ]
  deps = [
    ":bundle",
    "../../../scripts/backdo:browser_test_protocol",
    "../../core/common:bundle",
    "../../core/sdk:bundle",
    "../../panels/sources:bundle",
  ]
}
