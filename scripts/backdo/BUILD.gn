import("../build/ninja/copy.gni")
import("../build/typescript/typescript.gni")

node_ts_library("server") {
  sources = [
    "DebugServer.ts",
    "ManagedProcess.ts",
    "debug.ts",
  ]
}

node_ts_library("browser_test_protocol") {
  sources = [ "tests/BrowserTestProtocol.ts" ]
}

copy_to_gen("fixtures") {
  sources = [
    "fixtures/async-await.js",
    "fixtures/for-of-break.js",
    "fixtures/for.js",
  ]
}

node_ts_library("tests") {
  sources = [
    "tests/BrowserTestTarget.ts",
    "tests/FrontendTestServer.ts",
    "tests/browser-replay.test.ts",
    "tests/process-manager.test.ts",
  ]
  deps = [
    ":browser_test_protocol",
    ":server",
    "../../front_end/models/replay:browser_test_support",
    "../../test/conductor:implementation",
  ]
}

group("backdo") {
  deps = [
    ":fixtures",
    ":server",
    ":tests",
  ]
}
